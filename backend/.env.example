# ─── DevPilot AI — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=DevPilot AI
APP_VERSION=1.0.0
DEBUG=true
FRONTEND_URL=http://localhost:3000

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for embeddings + LLM analysis
OPENAI_API_KEY=sk-...

# LLM model: gpt-4o-mini (cheap) or gpt-4o (best quality)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token (PAT) with repo + read:user scopes
GITHUB_TOKEN=ghp_...

# OAuth App (for GitHub login) - create at github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev; switch to PostgreSQL for production
DATABASE_URL=sqlite:///./devpilot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/devpilot

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Vector DB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Repo settings ─────────────────────────────────────────────────────────────
REPO_CLONE_DIR=./repos
MAX_FILES_PER_REPO=500
MAX_FILE_SIZE_KB=200
MAX_REPOS_PER_USER=10
